# Meet 2.0 configuration. Copy to .env and fill in BOSON_API_KEY; everything else is optional.
BOSON_API_KEY=

# Live avatar (optional). Without these, rooms are voice only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BOSON_AVATAR_ID=builtin_claire_v1
MEET_AVATAR_DEFAULT=off

# Server
MEET_HOST=127.0.0.1
MEET_PORT=8600
# A token required to create rooms (set it when the server is reachable from the internet)
MEET_ADMIN=

# The AI
MEET_AI_NAME=Higgs
MEET_VOICE=chloe
MEET_LANG=en

# Contradiction interrupts (F4)
MEET_PROACTIVE_FACTS=1
MEET_FACT_DUCK_GAIN=0.15
MEET_FACT_MIN_CONFIDENCE=0.8
MEET_FACT_COOLDOWN=20
# Seconds a correction keeps talking over people before a real interruption can stop it
MEET_CORRECTION_GUARD=2

# Listening (F2, F6)
MEET_FILLERS_FILE=config/fillers.en.yaml
# off (default) | boson: Boson's server-side noise reduction (it garbled transcripts in tests)
MEET_DENOISE=off
MEET_LINE_SILENCE=0.45
MEET_CLAUSE_SILENCE=0.28
MEET_FLOOR_SILENCE=0.35

# Storage
MEET_KB_DIR=data/kb
MEET_LOG_DIR=out/rooms
